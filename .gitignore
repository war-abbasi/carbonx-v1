# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
frontend/dist/
frontend/.vite/

# Environment files — NEVER commit real secrets
.env
frontend/.env
backend/.env

# .env.production can be committed since secrets are set in Vercel dashboard
# but add this if you put secrets directly in it:
# frontend/.env.production

# Prisma
backend/prisma/migrations/*.sql
# Keep schema.prisma committed — it defines your data model

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Misc
*.tgz
.cache/
