// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  carbonEntries  CarbonEntry[]
  conversations  Conversation[]
  userChallenges UserChallenge[]

  @@map("users")
}

model UserChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int
  challengeId String    @db.VarChar(100)
  status      String    @default("active") @db.VarChar(20)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("user_challenges")
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New Chat") @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       @db.VarChar(20)   // 'user' | 'assistant'
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model CarbonEntry {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // commute | energy | travel | food | other
  subCategory String?  // car | bus | train | electricity | flight | beef | etc.
  scope       String   @default("personal") // scope1 | scope2 | scope3 | personal
  valueKg     Float    // CO₂e in kg
  quantity    Float    // raw input (km, kWh, hours, meals…)
  unit        String   // km | kWh | m3 | meal | hour
  description String?
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("carbon_entries")
}

enum Role {
  USER
  ADMIN
}
